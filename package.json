{
  "name": "playwright_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:login": "playwright test tests/LoginPage.spec.js",
    "test:search": "playwright test tests/SearchHotel.spec.js",
    "test:select": "playwright test tests/SelectHotel.spec.js",
    "test:book": "playwright test tests/BookHotel.spec.js",
    "test:smoke": "playwright test tests/SmokeTest.spec.js --project=smoke",
    "test:direct": "playwright test --config=playwright.config.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.3",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0"
  }
}
